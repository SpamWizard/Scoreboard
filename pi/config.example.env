# Copy to config.env (or export these) before running.

# Bind address for the aggregator (0.0.0.0 = all interfaces on the Pi)
SCOREBOARD_HOST=0.0.0.0
SCOREBOARD_PORT=8080

# Auth: there is no separate API secret.
# Stations must send: Authorization: Bearer <Pi-IP>
# Example: Pi at 192.168.1.50 → Bearer 192.168.1.50
# (Same string as in http://192.168.1.50:8080)

# SQLite path (relative to cwd or absolute)
SCOREBOARD_DB_PATH=data/scoreboard.db

# Ranking policy when the same team submits again: best | replace
# best = keep the higher score (tie: lower time_used_seconds)
SCOREBOARD_TEAM_POLICY=best

# --- saintcon.org public scoreboard push ---
# Leave SCOREBOARD_PUSH_URL empty to disable remote push (local board still works).
SCOREBOARD_PUSH_URL=https://saintcon.org/api/scoreboards/<id>
SCOREBOARD_PUSH_TOKEN=<key>
SCOREBOARD_PUSH_STATUS=live
SCOREBOARD_PUSH_MESSAGE=
SCOREBOARD_PUSH_MIN_INTERVAL_SECONDS=15
